INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell Arnold Press', 'Épaules', 'Kettlebell', '1. Clean a kettlebell to your épaule. Clean the kettlebell to your épaule by extending through the legs and hanches as you raise the kettlebell towards your épaule. The palm should be facing inward.
2. Looking straight ahead, press the kettlebell out and overhead, rotating your poignet so that your palm faces forward at the top of the motion.
3. Return the kettlebell to the position de départ, with the paumes vers in.', 'Muscles secondaires : Triceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_Arnold_Press/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell Dead Clean', 'Ischio-jambiers', 'Kettlebell', '1. Place kettlebell between vos pieds. To get in the position de départ, push your butt back and look straight ahead.
2. Clean the kettlebell to your épaule. Clean the kettlebell to your épaules by extending through the legs and hanches as you raise the kettlebell towards your épaule. The poignet should rotate as you do so.
3. Lower the kettlebell, keeping the ischio-jambiers loaded by keeping votre dos straight and your butt out.', 'Muscles secondaires : Mollets, Fessiers, Bas du dos, Quadriceps, Trapèzes. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_Dead_Clean/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell Figure 8', 'Abdominaux', 'Kettlebell', '1. Place one kettlebell between vos jambes and take a wider than épaule width stance. Bend over by pushing your butt out and keeping votre dos flat.
2. Pick up a kettlebell and pass it to your other hand between vos jambes. The receiving hand should reach from behind the legs. Go back and forth for several repetitions.', 'Muscles secondaires : Ischio-jambiers, Épaules. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_Figure_8/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell Hang Clean', 'Ischio-jambiers', 'Kettlebell', '1. Place kettlebell between vos pieds. To get in the position de départ, push your butt back and look straight ahead.
2. Clean kettlebell to your épaule. Clean the kettlebell to your épaules by extending through the legs and hanches as you raise the kettlebell towards your épaule. The poignet should rotate as you do so.
3. Lower kettlebell to a hanging position between vos jambes while keeping the ischio-jambiers loaded. Keep votre tête up en permanence.', 'Muscles secondaires : Mollets, Fessiers, Bas du dos, Épaules, Trapèzes. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_Hang_Clean/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell One-Legged Deadlift', 'Ischio-jambiers', 'Kettlebell', '1. Hold a kettlebell by the handle in one hand. Stand on one leg, on the same side that you hold the kettlebell.
2. Keeping that genou slightly bent, perform a stiff legged deadlift by bending at the hanche, extending your free leg behind you for balance.
3. Continue lowering the kettlebell until you are parallel to the ground, and then return to the upright position.', 'Muscles secondaires : Fessiers, Bas du dos. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_One-Legged_Deadlift/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell Pass Between The Legs', 'Abdominaux', 'Kettlebell', '1. Place one kettlebell between vos jambes and take a comfortable stance. Bend over by pushing your butt out and keeping votre dos flat.
2. Pick up a kettlebell and pass it to your other hand between vos jambes, in the fashion of a "W". Go back and forth for several repetitions.', 'Muscles secondaires : Fessiers, Ischio-jambiers, Épaules. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_Pass_Between_The_Legs/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell Pirate Ships', 'Épaules', 'Kettlebell', '1. With a wide stance, hold a kettlebell with both hands. Allow it to hang at waist level with vos bras extended. C''est votre position de départ.
2. Initiate le mouvement by turning to one side, swinging the kettlebell to head height. Briefly pause at the top of the motion.
3. Allow the bell to drop as you rotate to the opposite side, again raising the kettlebell to head height.
4. Répétez for the desired amount of repetitions.', 'Muscles secondaires : Abdominaux. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_Pirate_Ships/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell Pistol Squat', 'Quadriceps', 'Kettlebell', '1. Pick up a kettlebell with two hands and hold it by the horns. Hold one leg off of le sol and squat down on the other.
2. Squat down by flexing the genou and sitting back with the hanches, holding the kettlebell up in front of you.
3. Hold the bottom position for a second and then reverse the motion, driving through the heel and keeping votre tête and poitrine up.
4. Lower yourself again and Répétez.', 'Muscles secondaires : Mollets, Fessiers, Ischio-jambiers, Épaules. Niveau : Avancé.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_Pistol_Squat/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell Seated Press', 'Épaules', 'Kettlebell', '1. Asseyez-vous au sol and spread vos jambes out comfortably.
2. Clean one kettlebell to your épaule.
3. Press the kettlebell up and out until it is locked out overhead. Revenez en position de départ.', 'Muscles secondaires : Triceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_Seated_Press/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell Seesaw Press', 'Épaules', 'Kettlebell', '1. Clean two kettlebells two your épaules.
2. Press one kettlebell.
3. Lower the kettlebell and immediately press the other kettlebell. Make sure to do the same amount of reps on both sides.', 'Muscles secondaires : Triceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_Seesaw_Press/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell Sumo High Pull', 'Trapèzes', 'Kettlebell', '1. Place a kettlebell on the ground between vos pieds. Position vos pieds in a wide stance, and grasp the kettlebell with two hands. Set your hanches back as far as possible, with your genous bent. Keep your poitrine and head up. C''est votre position de départ.
2. Begin by extending the hanches and genous, simultaneously pulling the kettlebell to your épaules, raising your coudes as you do so. Reverse the motion to Revenez en position de départ.', 'Muscles secondaires : Adducteurs, Fessiers, Ischio-jambiers, Quadriceps, Épaules. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_Sumo_High_Pull/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell Thruster', 'Épaules', 'Kettlebell', '1. Clean two kettlebells to your épaules. Clean the kettlebells to your épaules by extending through the legs and hanches as you pull the kettlebells towards your épaules. Rotate your poignets as you do so. C''est votre position de départ.
2. Begin to squat by flexing your hanches and genous, lowering your hanches between vos jambes. Maintain an upright, straight back as you descend as low as you can.
3. At the bottom, reverse direction and squat by extending your genous and hanches, driving through your heels. As you do so, press both kettlebells overhead by extending vos bras straight up, using the momentum from the squat to help drive the poids upward.
4. As you begin the next repetition, return the poids to the épaules.', 'Muscles secondaires : Quadriceps, Triceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_Thruster/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell Turkish Get-Up (Lunge style)', 'Épaules', 'Kettlebell', '1. Allongez-vous au sol on le sol and press a kettlebell to the top position by extending the coude. Bend the genou on the same side as the kettlebell.
2. Keeping the kettlebell locked out en permanence, pivot to the opposite side and use your non- working arm to assist you in driving forward to the lunge position. Using your free hand, push yourself to a seated position, then progressing to one genou.
3. While looking up at the kettlebell, Lentement, Levez-vous. Reverse the motion back to the position de départ and Répétez.', 'Muscles secondaires : Abdominaux, Ischio-jambiers, Quadriceps, Triceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_Turkish_Get-Up_Lunge_style/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell Turkish Get-Up (Squat style)', 'Épaules', 'Kettlebell', '1. Allongez-vous au sol on le sol and press a kettlebell to the top position by extending the coude. Bend the genou on the same side as the kettlebell.
2. Keeping the kettlebell locked out en permanence, pivot to the opposite side and use your non- working arm to assist you in driving forward to the lunge position.
3. Using your free hand, push yourself to a seated position, then progressing to vos pieds. While looking up at the kettlebell, Lentement, Levez-vous. Reverse the motion back to the position de départ and Répétez.', 'Muscles secondaires : Abdominaux, Mollets, Ischio-jambiers, Quadriceps, Triceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_Turkish_Get-Up_Squat_style/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kettlebell Windmill', 'Abdominaux', 'Kettlebell', '1. Place a kettlebell in front of your lead foot and clean and press it overhead with your opposite arm. Clean the kettlebell to your épaule by extending through the legs and hanches as you pull the kettlebell towards your épaules. Rotate your poignet as you do so, so that the palm faces forward. Press it overhead by extending the coude.
2. Keeping the kettlebell locked out en permanence, push your butt out in the direction of the locked out kettlebell. Turn vos pieds out at a forty-five degree angle from the arm with the locked out kettlebell. Bending at the hanche to one side, sticking your butt out, Lentement, lean until you can touch le sol with your free hand. Keep your eyes on the kettlebell that you hold over votre tête en permanence.
3. Pause for a second after reaching the ground and reverse the motion back to the position de départ.', 'Muscles secondaires : Fessiers, Ischio-jambiers, Épaules, Triceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kettlebell_Windmill/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kipping Muscle Up', 'Dos', 'Autre', '1. Grip the rings using a false grip, with the base of your palms on top of the rings.
2. Begin with a movement swinging vos jambes backward slightly.
3. Counter that movement by swinging vos jambes forward and up, jerking your chin and poitrine back, pulling yourself up with both arms as you do so. As you reach the top position of the pull-up, pull the rings to your armpits as you roll your épaules forward, allowing your coudes to move straight back behind you. This puts you into the proper position to continue into the dip portion of le mouvement.
4. Maintaining control and stability, extend through the coude to complete the motion.
5. Use care when lowering yourself to the ground.', 'Muscles secondaires : Abdominaux, Biceps, Avant-bras, Milieu du dos, Épaules, Trapèzes, Triceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kipping_Muscle_Up/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Knee Across The Body', 'Fessiers', 'Autre', '1. Allongez-vous au sol with your right leg straight. Bend your left leg and lower it across votre corps, holding the genou down toward le sol with your right hand. (The genou doesn''t need to touch le sol if you''re tight.)
2. Place your left arm comfortably beside you and turn votre tête to the left. Imagine you have a poids tied to your tailbone. let your tailbone fall back toward le sol as your poitrine reaches in the opposite direction to stretch your lower back. Switch sides.', 'Muscles secondaires : Abducteurs, Bas du dos. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Knee_Across_The_Body/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Knee Circles', 'Mollets', 'Poids de corps', '1. Tenez-vous debout avec vos jambes together and hands by your waist.
2. Now move your genous in a circular motion as you breathe normally.
3. Répétez selon le nombre de répétitions souhaité.', 'Muscles secondaires : Ischio-jambiers, Quadriceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Knee_Circles/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Knee/Hip Raise On Parallel Bars', 'Abdominaux', 'Autre', '1. Position votre corps on the vertical leg raise banc so that your forearms are resting on the pads next to the torse and holding on to the handles. vos bras will be bent at a angle de 90 degrés.
2. The torse should be straight with the lower back pressed against the pad of the machine and the legs extended pointing towards le sol. C''est votre position de départ.
3. Now as you Expirez, lift vos jambes up as you keep them extended. Continue this movement until vos jambes are roughly parallèle au sol and then hold the contraction for a second. Conseil : Do not use any momentum or swinging as you perform cet exercice.
4. Lentement, go back to the position de départ as you Inspirez.
5. Répétez selon le nombre de répétitions souhaité.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Knee_Hip_Raise_On_Parallel_Bars/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Knee Tuck Jump', 'Ischio-jambiers', 'Poids de corps', '1. Begin in a comfortable standing position with your genous slightly bent. Hold vos mains in front of you, palms down with your fingertips together at poitrine height. C''est votre position de départ.
2. Rapidly dip down into a quarter squat and immediately explode upward. Drive the genous towards the poitrine, attempting to touch them to the palms of the hands.
3. Jump as high as you can, raising your genous up, and then ensure a good land be re-extending vos jambes, absorbing impact through be allowing the genous to rebend.', 'Muscles secondaires : Abducteurs, Adducteurs, Mollets, Fessiers, Quadriceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Knee_Tuck_Jump/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kneeling Arm Drill', 'Épaules', 'Autre', '1. This drill helps increase arm efficiency during the run. Begin kneeling, left foot in front, right genou down. Apply pressure through the front heel to keep your fessiers and ischio-jambiers activated.
2. Begin by blocking the arms in long, pendulum like swings. Close the arm angle, blocking with the arms as you would when jogging, progressing to a run and finally a sprint.
3. As soon as vos mains pass the hanche, accelerate them forward during the sprinting motion to move them as quickly as possible.
4. Switch genous and Répétez.', 'Muscles secondaires : Abdominaux. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kneeling_Arm_Drill/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kneeling Cable Crunch With Alternating Oblique Twists', 'Abdominaux', 'Poulie', '1. Connect a rope attachment to a high pulley cable and position a mat on le sol in front of it.
2. Grab the rope with both hands and kneel approximately two feet back from the tower.
3. Position the rope behind votre tête with vos mains by your ears.
4. Keep vos mains in the same place, contract your abdominaux and pull downward on the rope in a crunching movement until your coudes reach your genous.
5. Pause briefly at the bottom and rise up in a slow and controlled manner until you reach the position de départ.
6. Répétez the same downward movement until you''re halfway down, at which time you''ll begin rotating one of your coudes to the opposite genou.
7. Again, pause briefly at the bottom and rise up in a slow and controlled manner until you reach the position de départ.
8. Répétez the same movement as before, but alternate the other coude to the opposite genou.
9. Continue this series of movements to failure.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kneeling_Cable_Crunch_With_Alternating_Oblique_Twists/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kneeling Cable Triceps Extension', 'Triceps', 'Poulie', '1. Place a banc sideways in front of a high pulley machine.
2. Hold a straight bar attachment above votre tête with vos mains about 6 inches apart with your paumes vers down.
3. Face away from the machine and kneel.
4. Place votre tête and the back of your upper arms on the banc. Your coudes should be bent with the forearms pointing towards the high pulley. C''est votre position de départ.
5. While keeping your upper arms close to votre tête en permanence with the coudes in, press the bar out in a semicircular motion until the coudes are locked and vos bras are parallèle au sol. Contract the triceps hard and keep this position for a second. Expirez as you perform this movement.
6. Lentement, Revenez en position de départ as you Inspirez.
7. Répétez selon le nombre de répétitions souhaité.', 'Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kneeling_Cable_Triceps_Extension/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kneeling Forearm Stretch', 'Avant-bras', 'Autre', '1. Start by kneeling on a mat with your palms flat and your fingers pointing back toward your genous.
2. Lentement, lean back keeping your palms flat on le sol until you feel a stretch in your poignets and forearms. Maintenez 20-30 secondes.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kneeling_Forearm_Stretch/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kneeling High Pulley Row', 'Dos', 'Poulie', '1. Select the appropriate poids using a pulley that is above votre tête. Attach a rope to the cable and kneel a couple of feet away, holding the rope out in front of you with both arms extended. C''est votre position de départ.
2. Initiate le mouvement by flexing the coudes and fully retracting your épaules, pulling the rope toward your upper poitrine with your coudes out.
3. After pausing briefly, Lentement, Revenez en position de départ.', 'Muscles secondaires : Biceps, Milieu du dos. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kneeling_High_Pulley_Row/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kneeling Hip Flexor', 'Quadriceps', 'Autre', '1. Kneel on a mat and bring your right genou up so the bottom of your foot is on le sol and extend your left leg out behind you so the top of your foot is on le sol.
2. Shift your poids forward until you feel a stretch in your hanche. Maintenez 15- secondes, then Répétez for your other side.', 'Muscles secondaires : Quadriceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kneeling_Hip_Flexor/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kneeling Jump Squat', 'Fessiers', 'Barre', '1. Begin kneeling on le sol with a barre racked across the back of your épaules, or you can use votre corps poids for cet exercice. This can be done inside of a power rack to make unracking easier.
2. Sit back with your hanches until your fessiers touch vos pieds, keeping votre tête and poitrine up.
3. Explode up with your hanches, generating enough power to land with vos pieds flat on le sol.
4. Continue with the squat by driving through your heels and extending the genous to come to a standing position.', 'Muscles secondaires : Mollets, Ischio-jambiers, Quadriceps. Niveau : Avancé.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kneeling_Jump_Squat/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kneeling Single-Arm High Pulley Row', 'Dos', 'Poulie', '1. Attach a single handle to a high pulley and make your poids selection.
2. Kneel in front of the cable tower, taking the cable with one hand with your arm extended. C''est votre position de départ.
3. Starting with your paumes vers l''avant, pull the poids down to your torse by flexing the coude and retract the omoplates. As you do so, rotate the poignet so that at the completion of le mouvement, your palm is now facing you.
4. Après une pause, Revenez en position de départ.', 'Muscles secondaires : Biceps, Milieu du dos. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kneeling_Single-Arm_High_Pulley_Row/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Kneeling Squat', 'Fessiers', 'Barre', '1. Set the bar to the proper height in a power rack. Kneel behind the bar; it may be beneficial to put a mat down to pad your genous. Slide under the bar, racking it across the back of your épaules. Your omoplates should be retracted and the bar tight across votre dos. Unrack the poids.
2. With votre tête looking forward, sit back with your butt until you touch your mollets.
3. Reverse the motion, returning the torse to an upright position.', 'Muscles secondaires : Abdominaux, Ischio-jambiers, Bas du dos. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Kneeling_Squat/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Landmine 180''s', 'Abdominaux', 'Barre', '1. Position a bar into a landmine or securely anchor it in a corner. Load the bar to an appropriate poids.
2. Raise the bar from le sol, taking it to épaule height with both hands with vos bras extended in front of you. Adopt a wide stance. C''est votre position de départ.
3. Perform le mouvement by rotating the trunk and hanches as you swing the poids all the way down to one side. Keep vos bras extended throughout the exercise.
4. Reverse the motion to swing the poids all the way to the opposite side.
5. Continue alternating le mouvement until the set is complete.', 'Muscles secondaires : Fessiers, Bas du dos, Épaules. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Landmine_180s/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Landmine Linear Jammer', 'Épaules', 'Barre', '1. Position a bar into landmine or, lacking one, securely anchor it in a corner. Load the bar to an appropriate poids and position the handle attachment on the bar.
2. Raise the bar from le sol, taking the handles to your épaules. C''est votre position de départ.
3. In an athletic stance, squat by flexing your hanches and setting your hanches back, keeping vos bras flexed.
4. Reverse the motion by powerfully extending through the hanches, genous, and chevilles, while also extending the coudes to straighten the arms. This movement should be done explosively, coming out of the squat to full extension as powerfully as possible.
5. Revenez en position de départ.', 'Muscles secondaires : Abdominaux, Mollets, Pectoraux, Ischio-jambiers, Quadriceps, Triceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Landmine_Linear_Jammer/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Lateral Bound', 'Adducteurs', 'Poids de corps', '1. Assume a half squat position facing 90 degrees from your direction of travel. C''est votre position de départ.
2. Allow your lead leg to do a countermovement inward as you shift your poids to the outside leg.
3. Immediately push off and extend, attempting to bound to the side as far as possible.
4. Upon landing, immediately push off in the opposite direction, returning to your original start position.
5. Continue back and forth for several repetitions.', 'Muscles secondaires : Abducteurs, Mollets, Fessiers, Ischio-jambiers, Quadriceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Lateral_Bound/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Lateral Box Jump', 'Adducteurs', 'Autre', '1. Assume a comfortable standing position, with a short box positioned next to you. C''est votre position de départ.
2. Quickly dip into a quarter squat to initiate the stretch reflex, and immediately reverse direction to jump up and to the side.
3. Bring your genous high enough to ensure vos pieds have good clearance over the box.
4. Land on the center of the box, using vos jambes to absorb the impact.
5. Carefully jump down to the other side of the box, and continue going back and forth for several repetitions.', 'Muscles secondaires : Abducteurs, Mollets, Fessiers, Ischio-jambiers, Quadriceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Lateral_Box_Jump/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Lateral Cone Hops', 'Adducteurs', 'Autre', '1. Position a number of cones in a row several feet apart.
2. Stand next to the end of the cones, facing 90 degrees to the direction of travel. C''est votre position de départ.
3. Begin the jump by dipping with the genous to initiate a stretch reflex, and immediately reverse direction to push off the ground, jumping up and sideways over the cone.
4. Use vos jambes to absorb impact upon landing, and rebound into the next jump, continuing down the row of cones.', 'Muscles secondaires : Abducteurs, Mollets, Fessiers, Ischio-jambiers, Quadriceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Lateral_Cone_Hops/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Lateral Raise - With Bands', 'Épaules', 'Élastique', '1. To begin, stand on an exercise band so that tension begins at arm''s length. Grasp the handles using a pronated (paumes vers your cuisses) grip that is slightly less than épaule width. The handles should be resting on the sides of your cuisses. vos bras should be extended with a slight bend at the coudes and votre dos should be straight. C''est votre position de départ.
2. Use your side épaules to lift the handles to the sides as you expirez. Continue to lift the handles until they are slightly above parallel. Conseil : As you lift the handles, slightly tilt the hand as if you were pouring water and keep vos bras extended. Also, keep your torse stationary and pause for a second at the top of le mouvement.
3. Lower the handles back down Lentement, to the position de départ. Inspirez as you perform this portion of le mouvement.
4. Répétez selon le nombre de répétitions souhaité.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Lateral_Raise_-_With_Bands/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Latissimus Dorsi-SMR', 'Dos', 'Foam roller', '1. While lying on le sol, place a foam roll under votre dos and to one side, just behind your arm pit. C''est votre position de départ.
2. Keep the arm of the side being stretched behind and to the side of you as you shift your poids onto your lats, keeping your upper body off of the ground. Maintenez 10-30 secondes, and switch sides.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Latissimus_Dorsi-SMR/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Leg-Over Floor Press', 'Pectoraux', 'Kettlebell', '1. Allongez-vous au sol with one kettlebell in place on your poitrine, holding it by the handle. Extend leg on working side over leg on non-working side.Your free arm can be extended out to your side for support.
2. Press the kettlebll into a locked out position.
3. Lower the poids until the coude touches the ground, keeping the kettlebell above the coude. Répétez for the desired number of repetitions.', 'Muscles secondaires : Épaules, Triceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Leg-Over_Floor_Press/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Leg-Up Hamstring Stretch', 'Ischio-jambiers', 'Autre', '1. Allongez-vous au sol, bend one genou, and put that foot flat on le sol to stabilize your spine.
2. Extend the other leg in the air. If you''re tight, you wont be able to straighten it. That''s okay. Extend the genou so that the sole of the lifted foot faces the ceiling (or as close as you can get it).
3. Lentement, straighten the legs as much as possible and then pull the leg toward your nose. Switch sides.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Leg-Up_Hamstring_Stretch/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Leg Extensions', 'Quadriceps', 'Machine', '1. For cet exercice you will need to use a leg extension machine. First choose your poids and sit on the machine with vos jambes under the pad (feet pointed forward) and the hands holding the side bars. C''est votre position de départ. Conseil : You will need to adjust the pad so that it falls on top of your lower leg (just above vos pieds). Also, make sure that vos jambes form a angle de 90 degrés between the lower and upper leg. If the angle is less than 90-degrees then that means the genou is over the toes which in turn creates undue stress at the genou joint. If the machine is designed that way, either look for another machine or just make sure that when you start executing the exercise you stop going down once you hit the angle de 90 degrés.
2. Using your quadriceps, extend vos jambes to the maximum as you expirez. Ensure that the rest of the body remains stationary on the seat. Pause a second on the contracted position.
3. Lentement, lower the poids back to the original position as you inspirez, ensuring that you do not go past the angle de 90 degrés limit.
4. Répétez for the recommended amount of times.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Leg_Extensions/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Leg Lift', 'Fessiers', 'Poids de corps', '1. While standing up straight with both feet next to each other at around épaule width, grab a sturdy surface such as the sides of a squat rack or the top of a chair to brace yourself and keep balance.
2. With or without an cheville poids, lift one leg behind you as if performing a leg curl but standing up while keeping the other leg straight. Expirez as you perform this movement.
3. Lentement, bring the raised leg back to le sol as you Inspirez.
4. Répétez selon le nombre de répétitions souhaité.
5. Répétez le mouvement with the opposite leg.', 'Muscles secondaires : Ischio-jambiers. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Leg_Lift/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Leg Press', 'Quadriceps', 'Machine', '1. Using a leg press machine, sit down on the machine and place vos jambes on the platform directly in front of you at a medium (épaule width) foot stance. (Note: For the purposes of this discussion we will use the medium stance described above which targets overall development; however you can choose any of the three stances described in the foot positioning section).
2. Lower the safety bars holding the weighted platform in place and press the platform all the way up until vos jambes are fully extended in front of you. Conseil : Make sure that you do not lock your genous. Your torse and the legs should make a perfect angle de 90 degrés. C''est votre position de départ.
3. As you inspirez, Lentement, lower the platform until your upper and lower legs make a angle de 90 degrés.
4. Pushing mainly with the heels of vos pieds and using the quadriceps go back to the position de départ as you expirez.
5. Répétez selon le nombre de répétitions souhaité. and ensure to lock the safety pins properly once you are done. You do not want that platform falling on you fully loaded.', 'Muscles secondaires : Mollets, Fessiers, Ischio-jambiers. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Leg_Press/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Leg Pull-In', 'Abdominaux', 'Poids de corps', '1. Lie on an exercise mat with vos jambes extended and vos mains either paumes vers down next to you or under your fessiers. Conseil : My preference is with the hands next to me. C''est votre position de départ.
2. Bend your genous and pull your upper cuisses into your midsection as you Expirez. Continue the motion until your genous are around poitrine level. Contract your abdominaux as you execute this movement and Maintenez la position 1 seconde at the top. Conseil : As you perform the motion, the lower legs (mollets) should always remain parallèle au sol.
3. Revenez en position de départ as you inspirez.
4. Répétez selon le nombre de répétitions souhaité.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Leg_Pull-In/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Leverage Chest Press', 'Pectoraux', 'Machine', '1. Load an appropriate poids onto the pins and adjust the seat for your height. The handles should be near the bottom or middle of the pectorals at the beginning of the motion.
2. Your poitrine and head should be up and your omoplates retracted. C''est votre position de départ.
3. Press the handles forward by extending through the coude.
4. Après une pause, at the top, return the poids just above the start position, keeping tension on the muscles by not returning the poids to the stops until the set is complete.', 'Muscles secondaires : Épaules, Triceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Leverage_Chest_Press/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Leverage Deadlift', 'Quadriceps', 'Machine', '1. Load the pins to an appropriate poids. Position yourself directly between the handles. Grasp the bottom handles with a comfortable grip, and then lower your hanches as you take a breath. Look forward with votre tête and keep your poitrine up. C''est votre position de départ.
2. Return the poids to the position de départ.', 'Muscles secondaires : Fessiers, Ischio-jambiers. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Leverage_Deadlift/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Leverage Decline Chest Press', 'Pectoraux', 'Machine', '1. Load an appropriate poids onto the pins and adjust the seat for your height. The handles should be near the bottom of the pectorals at the beginning of the motion. Your poitrine and head should be up and your omoplates retracted. C''est votre position de départ.
2. Press the handles forward by extending through the coude.
3. Après une pause, at the top, return the poids just above the start position, keeping tension on the muscles by not returning the poids to the stops until the set is complete.', 'Muscles secondaires : Épaules, Triceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Leverage_Decline_Chest_Press/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Leverage High Row', 'Milieu du dos', 'Machine', '1. Load an appropriate poids onto the pins and adjust the seat height so that you can just reach the handles above you. Adjust the genou pad to help keep you down. Grasp the handles with a pronated grip. C''est votre position de départ.
2. Pull the handles towards your torse, retracting your omoplates as you flex the coude.
3. Pause at the bottom of the motion, and then Lentement, return the handles to the position de départ.
4. For multiple repetitions, avoid completely returning the poids to the stops to keep tension on the muscles being worked.', 'Muscles secondaires : Dos. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Leverage_High_Row/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Leverage Incline Chest Press', 'Pectoraux', 'Machine', '1. Load an appropriate poids onto the pins and adjust the seat for your height. The handles should be near the top of the pectorals at the beginning of the motion. Your poitrine and head should be up and your omoplates retracted. C''est votre position de départ.
2. Press the handles forward by extending through the coude.
3. Après une pause, at the top, return the poids just above the start position, keeping tension on the muscles by not returning the poids to the stops until the set is complete.', 'Muscles secondaires : Épaules, Triceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Leverage_Incline_Chest_Press/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Leverage Iso Row', 'Dos', 'Machine', '1. Load an appropriate poids onto the pins and adjust the seat height so that the handles are at poitrine level. Grasp the handles with either a neutral or pronated grip. C''est votre position de départ.
2. Pull the handles towards your torse, retracting your omoplates as you flex the coude.
3. Pause at the bottom of the motion, and then Lentement, return the handles to the position de départ. For multiple repetitions, avoid completely returning the poids to the stops to keep tension on the muscles being worked.', 'Muscles secondaires : Biceps, Milieu du dos. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Leverage_Iso_Row/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Leverage Shoulder Press', 'Épaules', 'Machine', '1. Load an appropriate poids onto the pins and adjust the seat for your height. The handles should be near the top of the épaules at the beginning of the motion. Your poitrine and head should be up and handles held with a pronated grip. C''est votre position de départ.
2. Press the handles upward by extending through the coude.
3. Après une pause, at the top, return the poids to just above the start position, keeping tension on the muscles by not returning the poids to the stops until the set is complete.', 'Muscles secondaires : Triceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Leverage_Shoulder_Press/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Leverage Shrug', 'Trapèzes', 'Machine', '1. Load the pins to an appropriate poids. Position yourself directly between the handles.
2. Grasp the top handles with a comfortable grip, and then lower your hanches as you take a breath. Look forward with votre tête and keep your poitrine up.
3. Drive through le sol with your heels, extending your hanches and genous as you rise to a standing position. Keep vos bras straight throughout le mouvement, finishing with your épaules back. C''est votre position de départ.
4. Raise the poids by shrugging the épaules towards your ears, moving straight up and down.
5. Pause at the top of the motion, and then return the poids to the position de départ.', 'Muscles secondaires : Avant-bras. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Leverage_Shrug/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Linear 3-Part Start Technique', 'Ischio-jambiers', 'Autre', '1. This drill helps you accelerate as quickly as possible into a sprint from a dead stop. It helps to use a line to start from. Begin with two feet on the line. Place your left foot with the toe next to your right cheville. Place your right foot 4-6 inches behind the left.
2. Place your right hand onto the line, and thing bring your nose close to your left genou.
3. Squat down as you lean foward, votre tête being lower than your hanches and your poids loaded onto the left leg. C''est votre position de départ.
4. Take your left hand up so that it is parallel to the ground, pointing behind you, and explode out when ready.', 'Muscles secondaires : Mollets, Quadriceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Linear_3-Part_Start_Technique/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Linear Acceleration Wall Drill', 'Ischio-jambiers', 'Autre', '1. Lean at around 45 degrees against a wall. vos pieds should be together, fessiers contracted.
2. Begin by lifting your right genou quickly, pausing, and then driving it straight down into the ground.
3. Switch legs, raising the opposite genou, and then attacking the ground straight down.
4. Répétez once more with your right leg, and as soon as the right foot strikes the ground hammer them out rapidly, alternating left and right as fast as you can.', 'Muscles secondaires : Mollets, Fessiers, Quadriceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Linear_Acceleration_Wall_Drill/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Linear Depth Jump', 'Quadriceps', 'Autre', '1. You will need two boxes or benches spaced a few feet away from each other. Begin by standing on one box facing towards the other platform.
2. To initiate le mouvement, gently drop down to the ground between your platforms, allowing the genous and hanches to flex.
3. Reverse the motion by exploding, extending through the hanches, genous, and chevilles to jump onto the other platform.
4. Land softly, asborbing the impact through the legs.', 'Muscles secondaires : Mollets, Fessiers, Ischio-jambiers. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Linear_Depth_Jump/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Log Lift', 'Épaules', 'Autre', '1. Begin standing with the log in front of you. Grasp the handles, and begin to clean the log. As you are bent over to start the clean, attempt to get the log as high as possible, pulling it into your poitrine. Extend through the hanches and genous to bring it up to complete the clean.
2. Push votre tête back and look up, creating a shelf on your poitrine to rest the log. Begin the press by dipping, flexing slightly through the genous and reversing the motion. This push press will generate momentum to start the log moving vertically. Continue by extending through the coudes to press the log above votre tête. There are no strict rules on form, so use whatever techniques you are most efficient with. As the log is pressed, ensure that you push votre tête through on each repetition, looking forward.
3. Répétez as many times as possible. Attempt to control the descent of the log as it is returned to the ground.', 'Muscles secondaires : Abdominaux, Pectoraux, Fessiers, Ischio-jambiers, Bas du dos, Milieu du dos, Quadriceps, Trapèzes, Triceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Log_Lift/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('London Bridges', 'Dos', 'Autre', '1. Attach a climbing rope to a high beam or cross member. Below it, ensure that the smith machine bar is locked in place with the safeties and cannot move. Alternatively, a secure box could also be utilized.
2. Stand on the bar, using the rope to balance yourself. C''est votre position de départ.
3. Keeping votre corps straight, lean back and lower votre corps by Lentement, going hand over hand with the rope. Continue until you are perpendiculaire à the ground.
