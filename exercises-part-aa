INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('3/4 Sit-Up', 'Abdominaux', 'Poids de corps', '1. Allongez-vous au sol and secure vos pieds. vos jambes should be bent at the genous.
2. Place vos mains behind or to the side of votre tête. You will begin with votre dos on the ground. C''est votre position de départ.
3. Flex your hanches and spine to raise your torse toward your genous.
4. At the top of the contraction your torse should be perpendiculaire à the ground. Reverse the motion, going only ¾ of the way down.
5. Répétez selon le nombre de répétitions souhaité.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/3_4_Sit-Up/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('90/90 Hamstring', 'Ischio-jambiers', 'Poids de corps', '1. Allongez-vous au sol, with one leg extended straight out.
2. With the other leg, bend the hanche and genou to 90 degrees. You may brace your leg with vos mains if necessary. C''est votre position de départ.
3. Extend your leg straight into the air, pausing briefly at the top. Return the leg to the position de départ.
4. Répétez for 10-20 repetitions, and then switch to the other leg.', 'Muscles secondaires : Mollets. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/90_90_Hamstring/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Ab Crunch Machine', 'Abdominaux', 'Machine', '1. Select a light resistance and sit down on the ab machine placing vos pieds under the pads provided and grabbing the top handles. vos bras should be bent at a angle de 90 degrés as you rest the triceps on the pads provided. C''est votre position de départ.
2. At the same time, begin to lift the legs up as you crunch your upper torse. Expirez as you perform this movement. Conseil : Be sure to use a slow and controlled motion. Concentrate on using your abdominaux to move the poids while relaxing vos jambes and feet.
3. Après une pause, Lentement, Revenez en position de départ as you Inspirez.
4. Répétez le mouvement for the prescribed amount of repetitions.', 'Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Ab_Crunch_Machine/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Ab Roller', 'Abdominaux', 'Autre', '1. Hold the Ab Roller with both hands and Mettez-vous à genoux.
2. Now place the ab roller on le sol in front of you so that you are on all vos mains and genous (as in a kneeling push up position). C''est votre position de départ.
3. Lentement, roll the ab roller straight forward, stretching votre corps into a straight position. Conseil : Go down as far as you can without touching le sol with votre corps. Inspirez during this portion of le mouvement.
4. Après une pause, at the stretched position, start pulling yourself back to the position de départ as you Expirez. Conseil : Go Lentement, and keep your abdominaux tight en permanence.', 'Muscles secondaires : Épaules. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Ab_Roller/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Adductor', 'Adducteurs', 'Foam roller', '1. Lie face down with one leg on a foam roll.
2. Rotate the leg so that the foam roll contacts against your inner cuisse. Shift as much poids onto the foam roll as can be tolerated.
3. While trying to relax the muscles if the inner cuisse, roll over the foam between your hanche and genou, holding points of tension for 10-30 seconds. Répétez with the other leg.', 'Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Adductor/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Adductor/Groin', 'Adducteurs', 'Autre', '1. Allongez-vous au sol with vos pieds raised towards the ceiling.
2. Have your partner hold vos pieds or chevilles. Abduct vos jambes as far as you can. C''est votre position de départ.
3. Attempt to squeeze vos jambes together for 10 or more seconds, while your partner prevents you from doing so.
4. Now, relax the muscles in vos jambes as your partner pushes vos pieds apart, stretching as far as is comfortable for you. Be sure to let your partner know when the stretch is adequate to prevent overstretching or injury.', 'Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Adductor_Groin/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Advanced Kettlebell Windmill', 'Abdominaux', 'Kettlebell', '1. Clean and press a kettlebell overhead with one arm.
2. Keeping the kettlebell locked out en permanence, push your butt out in the direction of the locked out kettlebell. Keep the non-working arm behind votre dos and turn vos pieds out at a forty-five degree angle from the arm with the kettlebell.
3. Lower yourself as far as possible.
4. Pause for a second and reverse the motion back to the position de départ.', 'Muscles secondaires : Fessiers, Ischio-jambiers, Épaules. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Advanced_Kettlebell_Windmill/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Air Bike', 'Abdominaux', 'Poids de corps', '1. Allongez-vous au sol with your lower back pressed to the ground. For cet exercice, you will need to put vos mains beside votre tête. Be careful however to not strain with the neck as you perform it. Now lift your épaules into the crunch position.
2. Bring genous up to where they are perpendiculaire à le sol, with your lower legs parallèle au sol. C''est votre position de départ.
3. Now simultaneously, Lentement, go through a cycle pedal motion kicking forward with the right leg and bringing in the genou of the left leg. Bring your right coude close to your left genou by crunching to the side, as you Expirez.
4. Go back to the initial position as you Inspirez.
5. Crunch to the opposite side as you cycle vos jambes and bring closer your left coude to your right genou and expirez.
6. Continue alternating in this manner until all of the recommended repetitions for each side have been completed.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Air_Bike/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('All Fours Quad Stretch', 'Quadriceps', 'Poids de corps', '1. Start off on vos mains and genous, then lift your leg off le sol and hold the foot with your hand.
2. Use your hand to hold the foot or cheville, keeping the genou fully flexed, stretching the quadriceps and hanche flexors.
3. Focus on extending your hanches, thrusting them towards le sol. Maintenez 10-20 secondes and then switch sides.', 'Muscles secondaires : Quadriceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/All_Fours_Quad_Stretch/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Alternate Hammer Curl', 'Biceps', 'Haltères', '1. Tenez-vous debout avec your torse upright and a haltère in each hand being held bras tendus. The coudes should be close to the torse.
2. The palms of the hands should be facing your torse. C''est votre position de départ.
3. While holding the upper arm stationary, curl the right poids forward while contracting the biceps as you Expirez. Continue le mouvement until your biceps is entièrement contracté and the haltères are at épaule level. Maintenez la position 1 seconde as you squeeze the biceps. Conseil : Only the forearms should move.
4. Lentement, begin to bring the haltères back to position de départ as your Inspirez.
5. Répétez le mouvement with the left hand. This equals one repetition.
6. Continue alternating in this manner for the recommended amount of repetitions.', 'Muscles secondaires : Avant-bras. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Alternate_Hammer_Curl/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Alternate Heel Touchers', 'Abdominaux', 'Poids de corps', '1. Allongez-vous au sol with the genous bent and the feet on le sol around 18-24 inches apart. vos bras should be extended by your side. C''est votre position de départ.
2. Crunch over your torse forward and up about 3-4 inches to the right side and touch your right heel as you hold the contraction for a second. Expirez while performing this movement.
3. Now go back Lentement, to the position de départ as you inspirez.
4. Now crunch over your torse forward and up around 3-4 inches to the left side and touch your left heel as you hold the contraction for a second. Expirez while performing this movement and then go back to the position de départ as you inspirez. Now that both heels have been touched, that is considered 1 repetition.
5. Continue alternating sides in this manner until all prescribed repetitions are done.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Alternate_Heel_Touchers/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Alternate Incline Dumbbell Curl', 'Biceps', 'Haltères', '1. Asseyez-vous sur un banc with a haltère in each hand being held bras tendus. Conseil : Keep the coudes close to the torse.C''est votre position de départ.
2. While holding the upper arm stationary, curl the right poids forward while contracting the biceps as you Expirez. As you do so, rotate the hand so that the palm is facing up. Continue le mouvement until your biceps is entièrement contracté and the haltères are at épaule level. Maintenez la position 1 seconde as you squeeze the biceps. Conseil : Only the forearms should move.
3. Lentement, begin to bring the haltère back to position de départ as your Inspirez.
4. Répétez le mouvement with the left hand. This equals one repetition.
5. Continue alternating in this manner for the recommended amount of repetitions.', 'Muscles secondaires : Avant-bras. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Alternate_Incline_Dumbbell_Curl/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Alternate Leg Diagonal Bound', 'Quadriceps', 'Autre', '1. Assume a comfortable stance with one foot slightly in front of the other.
2. Begin by pushing off with the front leg, driving the opposite genou forward and as high as possible before landing. Attempt to cover as much distance to each side with each bound.
3. It may help to use a line on the ground to guage distance from side to side.
4. Répétez the sequence with the other leg.', 'Muscles secondaires : Abducteurs, Adducteurs, Mollets, Fessiers, Ischio-jambiers. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Alternate_Leg_Diagonal_Bound/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Alternating Cable Shoulder Press', 'Épaules', 'Poulie', '1. Move the cables to the bottom of the tower and select an appropriate poids.
2. Grasp the cables and hold them at épaule height, paumes vers l''avant. C''est votre position de départ.
3. Keeping votre tête and poitrine up, extend through the coude to press one side directly over head.
4. After pausing at the top, Revenez en position de départ and Répétez de l''autre côté.', 'Muscles secondaires : Triceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Alternating_Cable_Shoulder_Press/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Alternating Deltoid Raise', 'Épaules', 'Haltères', '1. In a standing position, hold a pair of haltères at your side.
2. Keeping your coudes slightly bent, raise the poids directly in front of you to épaule height, avoiding any swinging or cheating.
3. Return the poids to your side.
4. On the next repetition, raise the poids laterally, raising them out to your side to about épaule height.
5. Return the poids to the position de départ and continue alternating to the front and side.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Alternating_Deltoid_Raise/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Alternating Floor Press', 'Pectoraux', 'Kettlebell', '1. Allongez-vous au sol with two kettlebells next to your épaules.
2. Position one in place on your poitrine and then the other, gripping the kettlebells on the handle with the paumes vers l''avant.
3. Extend both arms, so that the kettlebells are being held above your poitrine. Lower one kettlebell, bringing it to your poitrine and turn the poignet in the direction of the locked out kettlebell.
4. Raise the kettlebell and Répétez de l''autre côté.', 'Muscles secondaires : Abdominaux, Épaules, Triceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Alternating_Floor_Press/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Alternating Hang Clean', 'Ischio-jambiers', 'Kettlebell', '1. Place two kettlebells between vos pieds. To get in the position de départ, push your butt back and look straight ahead.
2. Clean one kettlebell to your épaule and hold on to the other kettlebell in a hanging position. Clean the kettlebell to your épaule by extending through the legs and hanches as you pull the kettlebell towards your épaules. Rotate your poignet as you do so.
3. Lower the cleaned kettlebell to a hanging position and clean the alternate kettlebell. Répétez.', 'Muscles secondaires : Biceps, Mollets, Avant-bras, Fessiers, Bas du dos, Trapèzes. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Alternating_Hang_Clean/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Alternating Kettlebell Press', 'Épaules', 'Kettlebell', '1. Clean two kettlebells to your épaules. Clean the kettlebells to your épaules by extending through the legs and hanches as you pull the kettlebells towards your épaules. Rotate your poignets as you do so.
2. Press one directly overhead by extending through the coude, turning it so the palm faces forward while holding the other kettlebell stationary .
3. Lower the pressed kettlebell to the position de départ and immediately press with your other arm.', 'Muscles secondaires : Triceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Alternating_Kettlebell_Press/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Alternating Kettlebell Row', 'Milieu du dos', 'Kettlebell', '1. Place two kettlebells in front of vos pieds. Bend your genous slightly and push your butt out as much as possible. As you bend over to get into the position de départ grab both kettlebells by the handles.
2. Pull one kettlebell off of le sol while holding on to the other kettlebell. Retract the omoplates of the working side, as you flex the coude, drawing the kettlebell towards your stomach or rib cage.
3. Lower the kettlebell in the working arm and Répétez with your other arm.', 'Muscles secondaires : Biceps, Dos. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Alternating_Kettlebell_Row/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Alternating Renegade Row', 'Milieu du dos', 'Kettlebell', '1. Place two kettlebells on le sol about épaule width apart. Position yourself on your toes and vos mains as though you were doing a pushup, with the body straight and extended. Use the handles of the kettlebells to support your upper body. You may need to position vos pieds wide for support.
2. Push one kettlebell into le sol and row the other kettlebell, retracting the omoplates of the working side as you flex the coude, pulling it to your side.
3. Then lower the kettlebell to le sol and begin the kettlebell in the opposite hand. Répétez for several reps.', 'Muscles secondaires : Abdominaux, Biceps, Pectoraux, Dos, Triceps. Niveau : Avancé.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Alternating_Renegade_Row/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Ankle Circles', 'Mollets', 'Autre', '1. Use a sturdy object like a squat rack to hold yourself.
2. Lift the right leg in the air (just around 2 inches from le sol) and perform a circular motion with the big toe. Pretend that you are drawing a big circle with it. Conseil : One circle equals 1 repetition. Breathe normally as you perform le mouvement.
3. When you are done with the right foot, then Répétez with the left leg.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Ankle_Circles/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Ankle On The Knee', 'Fessiers', 'Autre', '1. From a lying position, bend your genous and keep vos pieds on le sol.
2. Place your cheville of one foot on your opposite genou.
3. Grasp the cuisse or genou of the bottom leg and pull both of vos jambes into the poitrine. Relax your neck and épaules. Maintenez 10-20 secondes and then switch sides.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Ankle_On_The_Knee/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Anterior Tibialis-SMR', 'Mollets', 'Autre', '1. Begin seated on the ground with vos jambes bent and vos pieds on le sol.
2. Using a Muscle Roller or a rolling pin, apply pressure to the muscles on the outside of your shins. Work from just below the genou to above the cheville, pausing at points of tension for 10-30 seconds. Répétez de l''autre côté.', 'Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Anterior_Tibialis-SMR/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Anti-Gravity Press', 'Épaules', 'Barre', '1. Place a bar on the ground behind the head of an incline banc.
2. Lay on the banc face down. With a pronated grip, pick the barre up from le sol. Flex the coudes, performing a reverse curl to bring the bar near your poitrine. C''est votre position de départ.
3. To begin, press the barre out in front of votre tête by extending your coudes. Keep vos bras parallel to the ground throughout le mouvement.
4. Revenez en position de départ and Répétez to complete the set.', 'Muscles secondaires : Milieu du dos, Trapèzes, Triceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Anti-Gravity_Press/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Arm Circles', 'Épaules', 'Autre', '1. Levez-vous and extend vos bras straight out by the sides. The arms should be parallèle au sol and perpendicular (angle de 90 degrés) to your torse. C''est votre position de départ.
2. Lentement, start to make circles of about 1 foot in diameter with each outstretched arm. Breathe normally as you perform le mouvement.
3. Continue the circular motion of the outstretched arms for about ten seconds. Then reverse le mouvement, going the opposite direction.', 'Muscles secondaires : Trapèzes. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Arm_Circles/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Arnold Dumbbell Press', 'Épaules', 'Haltères', '1. Asseyez-vous sur un banc with back support and hold two haltères in front of you at about upper poitrine level with your paumes vers votre corps and your coudes bent. Conseil : vos bras should be next to your torse. The position de départ should look like the contracted portion of a haltère curl.
2. Now to perform le mouvement, raise the haltères as you rotate the palms of vos mains until they are facing forward.
3. Continue lifting the haltères until vos bras are extended above you in straight arm position. Expirez as you perform this portion of le mouvement.
4. Après une pause, at the top, begin to lower the haltères to the original position by rotating the palms of vos mains towards you. Conseil : The left arm will be rotated in a counter clockwise manner while the right one will be rotated clockwise. Inspirez as you perform this portion of le mouvement.
5. Répétez selon le nombre de répétitions souhaité.', 'Muscles secondaires : Triceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Arnold_Dumbbell_Press/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Around The Worlds', 'Pectoraux', 'Haltères', '1. Lay down on a flat banc holding a haltère in each hand with the palms of the hands facing towards the ceiling. Conseil : vos bras should be parallèle au sol and next to your cuisses. To avoid injury, make sure that you keep your coudes slightly bent. C''est votre position de départ.
2. Now move the haltères by creating a semi-circle as you displace them from the initial position to over the head. All of le mouvement should happen with the arms parallèle au sol en permanence. Inspirez as you perform this portion of le mouvement.
3. Reverse le mouvement to return the poids to the position de départ as you expirez.', 'Muscles secondaires : Épaules. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Around_The_Worlds/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Atlas Stone Trainer', 'Bas du dos', 'Autre', '1. This trainer is effective for developing Atlas Stone strength for those who don''t have access to stones, and are typically made from bar ends or heavy pipe.
2. Begin by loading the desired poids onto the bar. Straddle the poids, wrapping vos bras around the implement, bending at the hanches.
3. Begin by pulling the poids up past the genous, extending through the hanches. As the poids clears the genous, it can be lapped by resting it on your cuisses and sitting back, hugging it tightly to your poitrine.
4. Finish le mouvement by extending through your hanches and genous to raise the poids as high as possible. The poids can be returned to the lap or to the ground for successive repetitions.', 'Muscles secondaires : Biceps, Avant-bras, Fessiers, Ischio-jambiers, Quadriceps. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Atlas_Stone_Trainer/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Atlas Stones', 'Bas du dos', 'Autre', '1. Begin with the atlas stone between vos pieds. Bend at the hanches to wrap vos bras vertically around the Atlas Stone, attempting to get your fingers underneath the stone. Many stones will have a small flat portion on the bottom, which will make the stone easier to hold.
2. Pulling the stone into your torse, drive through the back half of vos pieds to pull the stone from the ground.
3. As the stone passes the genous, lap it by sitting backward, pulling the stone on top of your cuisses.
4. Sit low, getting the stone high onto your poitrine as you change your grip to reach over the stone. Stand, driving through with your hanches. Close distance to the loading platform, and lean back, extending the hanches to get the stone as high as possible.', 'Muscles secondaires : Abdominaux, Adducteurs, Biceps, Mollets, Avant-bras, Fessiers, Ischio-jambiers, Milieu du dos, Quadriceps, Trapèzes. Niveau : Avancé.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Atlas_Stones/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Axle Deadlift', 'Bas du dos', 'Autre', '1. Approach the bar so that it is centered over vos pieds. You feet should be about hanche width apart. Bend at the hanche to grip the bar at épaule width, allowing your omoplates to protract. Typically, you would use an over/under grip.
2. With vos pieds and your grip set, take a big breath and then lower your hanches and flex the genous until your shins contact the bar. Look forward with votre tête, keep your poitrine up and votre dos arched, and begin driving through the heels to move the poids upward.
3. After the bar passes the genous, aggressively pull the bar back, pulling your omoplates together as you drive your hanches forward into the bar.
4. Lower the bar by bending at the hanches and guiding it to le sol.', 'Muscles secondaires : Avant-bras, Fessiers, Ischio-jambiers, Milieu du dos, Quadriceps, Trapèzes. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Axle_Deadlift/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Back Flyes - With Bands', 'Épaules', 'Élastique', '1. Run a band around a stationary post like that of a squat rack.
2. Grab the band by the handles and stand back so that the tension in the band rises.
3. Extend and lift the arms straight in front of you. Conseil : vos bras should be straight and parallèle au sol while perpendiculaire à your torse. vos pieds should be firmly planted on le sol spread at épaule width. C''est votre position de départ.
4. As you expirez, move vos bras to the sides and back. Keep vos bras extended and parallèle au sol. Continue le mouvement until the arms are extended to your sides.
5. Après une pause, go back to the original position as you inspirez.
6. Répétez selon le nombre de répétitions souhaité.', 'Muscles secondaires : Milieu du dos, Triceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Back_Flyes_-_With_Bands/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Backward Drag', 'Quadriceps', 'Autre', '1. Load a sled with the desired poids, attaching a rope or straps to the sled that you can hold onto.
2. Begin the exercise by moving backwards for a given distance. Leaning back, extend through the legs for short steps to move as quickly as possible.', 'Muscles secondaires : Mollets, Avant-bras, Fessiers, Ischio-jambiers, Bas du dos. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Backward_Drag/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Backward Medicine Ball Throw', 'Épaules', 'Medecine ball', '1. cet exercice is best done with a partner. If you lack a partner, the ball can be thrown and retrieved or thrown against a wall.
2. Begin standing a few meters in front of your partner, both facing the same direction. Begin holding the ball between vos jambes.
3. Squat down and then forcefully reverse direction, coming to full extension and you toss the ball over votre tête to your partner.
4. Your partner can then roll the ball back to you. Répétez for the desired number of repetitions.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Backward_Medicine_Ball_Throw/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Balance Board', 'Mollets', 'Autre', '1. Place a balance board in front of you.
2. Levez-vous on it and try to balance yourself.
3. Hold the balance for as long as desired.', 'Muscles secondaires : Ischio-jambiers, Quadriceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Balance_Board/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Ball Leg Curl', 'Ischio-jambiers', 'Swiss ball', '1. Begin on le sol laying on votre dos with vos pieds on top of the ball.
2. Position the ball so that when vos jambes are extended your chevilles are on top of the ball. C''est votre position de départ.
3. Raise your hanches off of the ground, keeping your poids on the omoplates and vos pieds.
4. Flex the genous, pulling the ball as close to you as you can, contracting the ischio-jambiers.
5. Après une pause, Revenez en position de départ.', 'Muscles secondaires : Mollets, Fessiers. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Ball_Leg_Curl/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Band Assisted Pull-Up', 'Dos', 'Autre', '1. Choke the band around the center of the pullup bar. You can use different bands to provide varying levels of assistance.
2. Pull the end of the band down, and place one bent genou into the loop, ensuring it won''t slip out. Take a medium to prise large on the bar. C''est votre position de départ.
3. Pull yourself upward by contracting the lats as you flex the coude. The coude should be driven to your side. Pull to the front, attempting to get your chin over the bar. Avoid swinging or jerking movements.
4. Après une pause, Revenez en position de départ.', 'Muscles secondaires : Abdominaux, Avant-bras, Milieu du dos. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Band_Assisted_Pull-Up/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Band Good Morning', 'Ischio-jambiers', 'Élastique', '1. Using a 41 inch band, stand on one end, spreading vos pieds a small amount. Bend at the hanches to loop the end of the band behind your neck. C''est votre position de départ.
2. Keeping vos jambes straight, extend through the hanches to come to a near vertical position.
3. Ensure that you do not round votre dos as you go down back to the position de départ.', 'Muscles secondaires : Fessiers, Bas du dos. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Band_Good_Morning/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Band Good Morning (Pull Through)', 'Ischio-jambiers', 'Élastique', '1. Loop the band around a post. Standing a little ways away, loop the opposite end around the neck. vos mains can help hold the band in position.
2. Begin by bending at the hanches, getting your butt back as far as possible. Keep votre dos flat and bend forward to about 90 degrees. Your genous should be only slightly bent.
3. Revenez en position de départ be driving through with the hanches to come back to a standing position.', 'Muscles secondaires : Fessiers, Bas du dos. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Band_Good_Morning_Pull_Through/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Band Hip Adductions', 'Adducteurs', 'Élastique', '1. Anchor a band around a solid post or other object.
2. Tenez-vous debout avec your left side to the post, and put your right foot through the band, getting it around the cheville.
3. Levez-vous straight and hold onto the post if needed. C''est votre position de départ.
4. Keeping the genou straight, raise your right legs out to the side as far as you can.
5. Revenez en position de départ and Répétez for the desired rep count.
6. Switch sides.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Band_Hip_Adductions/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Band Pull Apart', 'Épaules', 'Élastique', '1. Begin with vos bras extended straight out in front of you, holding the band with both hands.
2. Initiate le mouvement by performing a reverse fly motion, moving vos mains out laterally to your sides.
3. Keep your coudes extended as you perform le mouvement, bringing the band to your poitrine. Ensure that you keep your épaules back during the exercise.
4. Pause as you complete le mouvement, returning to the position de départ under control.', 'Muscles secondaires : Milieu du dos, Trapèzes. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Band_Pull_Apart/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Band Skull Crusher', 'Triceps', 'Élastique', '1. Secure a band to the base of a rack or the banc. Lay on the banc so that the band is lined up with votre tête.
2. Take hold of the band, raising your coudes so that the upper arm is perpendiculaire à le sol. With the coude flexed, the band should be above votre tête. C''est votre position de départ.
3. Extend through the coude to straighten your arm, keeping your upper arm in place. Pause at the top of the motion, and Revenez en position de départ.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Band_Skull_Crusher/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Barbell Ab Rollout', 'Abdominaux', 'Barre', '1. For cet exercice you will need to get into a pushup position, but instead of having vos mains of le sol, you will be grabbing on to an Olympic barre (loaded with 5-10 lbs on each side) instead. C''est votre position de départ.
2. While keeping a slight arch on votre dos, lift your hanches and roll the barre towards vos pieds as you expirez. Conseil : As you perform le mouvement, your fessiers should be coming up, you should be keeping the abdominaux tight and should maintain votre dos posture en permanence. Also vos bras should be staying perpendiculaire à le sol throughout le mouvement. If you don''t, you will work out your épaules and back more than the abdominaux.
3. After a second contraction at the top, start to roll the barre back forward to the position de départ Lentement, as you inspirez.
4. Répétez selon le nombre de répétitions souhaité.', 'Muscles secondaires : Bas du dos, Épaules. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Barbell_Ab_Rollout/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Barbell Ab Rollout - On Knees', 'Abdominaux', 'Barre', '1. Hold an Olympic barre loaded with 5-10lbs on each side and Mettez-vous à genoux.
2. Now place the barre on le sol in front of you so that you are on all vos mains and genous (as in a kneeling push up position). C''est votre position de départ.
3. Lentement, roll the barre straight forward, stretching votre corps into a straight position. Conseil : Go down as far as you can without touching le sol with votre corps. Inspirez during this portion of le mouvement.
4. Après une pause, at the stretched position, start pulling yourself back to the position de départ as you Expirez. Conseil : Go Lentement, and keep your abdominaux tight en permanence.', 'Muscles secondaires : Bas du dos, Épaules. Niveau : Avancé.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Barbell_Ab_Rollout_-_On_Knees/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Barbell Bench Press - Medium Grip', 'Pectoraux', 'Barre', '1. Allongez-vous au sol on a flat banc. Using a prise moyenne (a grip that creates a angle de 90 degrés in the middle of le mouvement between the forearms and the upper arms), lift the bar from the rack and hold it straight over you with vos bras locked. C''est votre position de départ.
2. From the position de départ, Inspirez and begin coming down Lentement, until the bar touches your middle poitrine.
3. Après une pause, push the bar back to the position de départ as you Expirez. Focus on pushing the bar using your poitrine muscles. Lock vos bras and squeeze your poitrine in the contracted position at the top of the motion, Maintenez la position 1 seconde and then start coming down Lentement, again. Conseil : Ideally, lowering the poids should take about twice as long as raising it.
4. Répétez le mouvement for the prescribed amount of repetitions.
5. When you are done, place the bar back in the rack.', 'Muscles secondaires : Épaules, Triceps. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Barbell_Bench_Press_-_Medium_Grip/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Barbell Curl', 'Biceps', 'Barre', '1. Tenez-vous debout avec your torse upright while holding a barre at a épaule-width grip. The palm of vos mains should be facing forward and the coudes should be close to the torse. C''est votre position de départ.
2. While holding the upper arms stationary, curl the poids forward while contracting the biceps as you Expirez. Conseil : Only the forearms should move.
3. Continue le mouvement until your biceps are entièrement contracté and the bar is at épaule level. Maintenez la position 1 seconde and squeeze the biceps hard.
4. Lentement, begin to bring the bar back to position de départ as your Inspirez.
5. Répétez selon le nombre de répétitions souhaité.', 'Muscles secondaires : Avant-bras. Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Barbell_Curl/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Barbell Curls Lying Against An Incline', 'Biceps', 'Barre', '1. Lie against an incline banc, with vos bras holding a barre and hanging down in a horizontal line. C''est votre position de départ.
2. While keeping the upper arms stationary, curl the poids up as high as you can while squeezing the biceps. Expirez as you perform this portion of le mouvement. Conseil : Only the forearms should move. Do not swing the arms.
3. After a second contraction, Lentement, go back to the position de départ as you inspirez. Conseil : Make sure that you go all of the way down.
4. Répétez selon le nombre de répétitions souhaité.', 'Niveau : Débutant.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Barbell_Curls_Lying_Against_An_Incline/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Barbell Deadlift', 'Bas du dos', 'Barre', '1. Stand in front of a loaded barre.
2. While keeping the back as straight as possible, bend your genous, bend forward and grasp the bar using a medium (épaule width) prise en pronation. This will be the position de départ of the exercise. Conseil : If it is difficult to hold on to the bar with this grip, alternate your grip or use poignet straps.
3. While holding the bar, start the lift by pushing with vos jambes while simultaneously getting your torse to the upright position as you Expirez. In the upright position, stick your poitrine out and contract the back by bringing the omoplates back. Think of how the soldiers in the military look when they are in standing in attention.
4. Go back to the position de départ by bending at the genous while simultaneously leaning the torse forward at the waist while keeping the back straight. When the poids on the bar touch le sol you are back at the position de départ and ready to perform another repetition.
5. Perform the amount of repetitions prescribed in the program.', 'Muscles secondaires : Mollets, Avant-bras, Fessiers, Ischio-jambiers, Dos, Milieu du dos, Quadriceps, Trapèzes. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Barbell_Deadlift/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Barbell Full Squat', 'Quadriceps', 'Barre', '1. cet exercice is best performed inside a squat rack for safety purposes. To begin, first set the bar on a rack just above épaule level. Once the correct height is chosen and the bar is loaded, step under the bar and place the back of your épaules (slightly below the neck) across it.
2. Hold on to the bar using both arms at each side and lift it off the rack by first pushing with vos jambes and at the same time straightening your torse.
3. Step away from the rack and position vos jambes using a épaule-width medium stance with the toes slightly pointed out. Keep votre tête up en permanence and maintain a straight back. C''est votre position de départ.
4. Begin to Lentement, lower the bar by bending the genous and sitting back with your hanches as you maintain a straight posture with the head up. Continue down until your ischio-jambiers are on your mollets. Inspirez as you perform this portion of le mouvement.
5. Begin to raise the bar as you expirez by pushing le sol with the heel or middle of your foot as you straighten the legs and extend the hanches to go back to the position de départ.
6. Répétez selon le nombre de répétitions souhaité.', 'Muscles secondaires : Mollets, Fessiers, Ischio-jambiers, Bas du dos. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Barbell_Full_Squat/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Barbell Glute Bridge', 'Fessiers', 'Barre', '1. Begin seated on the ground with a loaded barre over vos jambes. Using a fat bar or having a pad on the bar can greatly reduce the discomfort caused by cet exercice. Roll the bar so that it is directly above your hanches, and lay down flat on le sol.
2. Begin le mouvement by driving through with your heels, extending your hanches vertically through the bar. Your poids should be supported by your upper back and the heels of vos pieds.
3. Extend as far as possible, then reverse the motion to Revenez en position de départ.', 'Muscles secondaires : Mollets, Ischio-jambiers. Niveau : Intermédiaire.', 'https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/Barbell_Glute_Bridge/0.jpg') ON CONFLICT DO NOTHING;
INSERT INTO public.exercises (name, muscle_group, equipment, description, tips, gif_url) VALUES ('Barbell Guillotine Bench Press', 'Pectoraux', 'Barre', '1. Using a prise moyenne (a grip that creates a angle de 90 degrés in the middle of le mouvement between the forearms and the upper arms), lift the bar from the rack and hold it straight over your neck with vos bras locked. C''est votre position de départ.
2. As you Inspirez, bring the bar down Lentement, until it is about 1 inch from your neck.
